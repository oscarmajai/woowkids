# Configuración del backend para desarrollo local (uvicorn fuera de Docker).
# Copia este archivo a .env (ignorado por git). Los valores apuntan al stack de
# docker-compose.dev.yml (PostgreSQL en :5433 y MinIO en :9000).
# Para los contenedores de producción se usa el .env.example de la raíz.

# Clave de firma de los JWT. La API rechaza una vacía o la de fábrica.
SECRET_KEY=cambia-esto-en-produccion
DATABASE_URL=postgresql://dev:dev@localhost:5433/mercury
CORS_ORIGINS=["http://localhost:5173"]
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# ACCESS_TOKEN_REMEMBER_ME_MINUTES=10080

# Seguridad de sesión. Los valores comentados son los de por defecto.
# COOKIE_SECURE: cookie del refresh token solo por HTTPS (los navegadores la
# aceptan también en localhost).
# REFRESH_EN_BODY y WS_ACEPTA_JWT: compatibilidad con clientes anteriores, que
# leían el refresh token del body y mandaban el JWT en la URL del WebSocket.
# COOKIE_SECURE=true
# REFRESH_EN_BODY=true
# WS_ACEPTA_JWT=true
# WS_TICKET_TTL_SECONDS=30

# Almacenamiento de archivos (MinIO). Obligatorio: sin él la API no termina de arrancar.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=mercury
# MINIO_SECURE=false

# Exige el token de PIN de cajero y administrador al confirmar un turno de caja.
# EXIGIR_PIN_TOKEN=true

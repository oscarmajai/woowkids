# Imagen TODO EN UNO de Woow Kids: frontend + API + PostgreSQL + MinIO en un solo
# contenedor, con todos los datos en el volumen /data.
#
# No recompila nada: parte de las imágenes woowkids-frontend y woowkids-backend
# que construye `docker compose build` (el release las construye igual en el
# runner y solo publica esta).
#
#   docker run -d -p 8080:80 -v woowkids_data:/data ghcr.io/oscarmajai/woowkids:latest
#
# Local:  docker compose build && docker build -f Dockerfile.allinone \
#           -t woowkids .
#
# Para producción a escala se recomiendan las imágenes separadas (docker-compose.yml).
ARG FRONTEND_IMAGE=woowkids-frontend:local
ARG BACKEND_IMAGE=woowkids-backend:local
# MinIO: dl.min.io ya no distribuye binarios (410) y Docker Hub y quay.io dejaron
# de servir la imagen, así que se toma la de Chainguard (mismo binario AGPL).
# RELEASE.2026-09-22T19-25-18Z, fijada por digest (Chainguard solo publica latest).
ARG MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:4cf4831a2bbcf13ddca09c1cbcc9faff716dd3c4247e0babc32864b8ee8e0034

FROM ${FRONTEND_IMAGE} AS frontend
FROM ${MINIO_IMAGE} AS minio

FROM ${BACKEND_IMAGE}
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql nginx curl ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default \
    && pip install --no-cache-dir supervisor==4.3.0

COPY --from=frontend /usr/share/nginx/html /usr/share/woowkids/front
COPY --from=minio /usr/bin/minio /usr/local/bin/minio
COPY docker/allinone/nginx.conf /etc/nginx/conf.d/woowkids.conf
COPY docker/allinone/nginx/ /etc/nginx/woowkids/
COPY docker/allinone/supervisord.conf /etc/woowkids/supervisord.conf
COPY docker/allinone/start.sh docker/allinone/tls.sh docker/allinone/instalar-certificado.html /etc/woowkids/
RUN chmod +x /etc/woowkids/start.sh /etc/woowkids/tls.sh \
    && ln -sf /etc/woowkids/supervisord.conf /etc/supervisord.conf

# Valores genéricos por defecto: cámbialos con -e al correr el contenedor.
# SECRET_KEY no tiene valor por defecto: si no se pasa, el arranque genera una
# aleatoria y la guarda en la BD. El administrador inicial debe cambiar su
# contraseña la primera vez que entra.
ENV POSTGRES_USER=admin \
    POSTGRES_PASSWORD=admin1234 \
    POSTGRES_DB=woowkids \
    MINIO_ACCESS_KEY=admin \
    MINIO_SECRET_KEY=admin1234 \
    MINIO_BUCKET=woowkids \
    MINIO_ENDPOINT=127.0.0.1:9000 \
    MINIO_SECURE=false \
    COOKIE_SECURE=false \
    SEED_DEMO=false \
    ADMIN_EMAIL=admin@woowkids.com \
    ADMIN_PASSWORD=admin1234 \
    CORS_ORIGINS='["http://localhost:8080"]' \
    BACKUP_CADA_HORAS=6 \
    BACKUP_DIAS_CONSERVAR=14 \
    WOOWKIDS_DOMINIOS= \
    REDIRIGIR_HTTPS=false \
    HTTPS_PUERTO=443

VOLUME ["/data"]
# Opcional: monta una carpeta del equipo en /respaldos (-v C:\WoowKids\respaldos:/respaldos)
# para que los respaldos automáticos queden fuera del volumen de datos.
# 443: app y API por HTTPS (certificado en /data/tls, ver tls.sh). 80: página
# para instalar el certificado y la app por HTTP o la redirección a HTTPS.
# 9001: consola de MinIO (opcional).
EXPOSE 80 443 9001

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -fs http://127.0.0.1:8000/openapi.json -o /dev/null

ENTRYPOINT ["/etc/woowkids/start.sh"]
